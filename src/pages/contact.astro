---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { social } from '../config';
---

<Layout title="联系" description="Hins 的 GitHub 主页与摄影网站。">
  <article class="page prose">
    <h1 class="page__title">联系</h1>
    <p class="lede">可以在 GitHub 找到我。</p>
    <ul class="contact-list">
      <li>
        <a class="contact-card" href={social.github} target="_blank" rel="noopener noreferrer">
          <span class="contact-card__icon"><Icon name="github" /></span>
          <span class="contact-card__text">
            <span class="contact-card__label">GitHub</span>
            <span class="contact-card__handle">@hw54</span>
          </span>
          <span class="contact-card__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
    <p><a class="text-link" href="/license">图片使用说明 →</a></p>
  </article>
</Layout>
